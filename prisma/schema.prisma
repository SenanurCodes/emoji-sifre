generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Message {
  id             Int      @id @default(autoincrement())
  originalText   String
  encryptedEmoji String
  createdAt      DateTime @default(now())
}